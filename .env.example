# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 git에 올라가지 않는다.

# mock: API 키 없이 가짜 응답 / live: 실제 Claude (키가 없으면 자동으로 mock)
AI_MODE=live
# 서버에서만 읽는다. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것
ANTHROPIC_API_KEY=
# 비워 두면 claude-haiku-5-5. 대사 품질 비교할 때 claude-sonnet-5-5로 바꿔 본다
AI_MODEL=

# off 로 두면 AI 사고(thinking)를 끈다. 개발 서버 로그의 [AI ...] 사용량으로 비교
AI_THINKING=
